# medi-chat 環境変数設定例
# FastAPI-only authentication. Required locally and on Vercel; never NEXT_PUBLIC.
AUTH_ISSUER=https://YOUR_APP_DOMAIN
AUTH_AUDIENCE=medi-chat
AUTH_KEY_ID=primary
# RSA private PEM (literal \n is accepted), and JSON mapping kid to public PEM.
AUTH_PRIVATE_KEY=
# Local development: use a project-relative file so Next.js receives no PEM.
AUTH_PRIVATE_KEY_FILE=
AUTH_PUBLIC_KEYS=
AUTH_HASH_PARALLELISM=2
AUTH_LOGIN_LIMIT=10
AUTH_ADDRESS_LIMIT=60
AUTH_LOGIN_WINDOW_SECONDS=900
# Explicit PostgreSQL targets. URL-encode passwords.
# Runtime uses app role; explicit migrations use owner role. Root .env.local is shared by app and CLI.
# MEDI_CHAT_DATABASE_URL=postgresql+psycopg://medi_chat_app:<password>@127.0.0.1:15432/medi_chat_dev
# MEDI_CHAT_MIGRATION_DATABASE_URL=postgresql+psycopg://medi_chat_owner:<password>@127.0.0.1:15432/medi_chat_dev
# TEST_DATABASE_URL=postgresql+psycopg://medi_chat_owner:<password>@127.0.0.1:15432/medi_chat_test
# TEST_RUNTIME_DATABASE_URL=postgresql+psycopg://medi_chat_app:<password>@127.0.0.1:15432/medi_chat_test
# このファイルをリポジトリルートの .env.local にコピーして設定してください。
# キーが未設定でも、自動的にモック対話モードで動作します。

# Google Gemini API キー
# https://aistudio.google.com/ で取得可能
GEMINI_API_KEY=

# OpenAI API キー
# https://platform.openai.com/api-keys で取得可能
OPENAI_API_KEY=

# LangSmith / LangGraph トレーシング設定
# トレースを LangSmith に送信する場合は true に設定し、API キーを指定してください
# https://smith.langchain.com/
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medi-chat
# 任意：回答の👍/👎評価。ランダムな32バイト以上の秘密文字列を全インスタンスで共有。
# 未設定・32バイト未満・トレース無効・sampling rateが1以外の場合は評価を無効化。
MEDI_CHAT_FEEDBACK_SECRET=

# TypeSafe / Jev API キー (添付文書の根拠候補の関連度検索用)
# 未設定時はロジック検索の結果のみを返します
TYPESAFE_API_KEY=
# JEV_API_KEY= も同等に認識されます

# バックエンド WebSocket 接続先 (Next.js から参照する場合)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat
