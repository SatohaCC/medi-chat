{
  "name": "medi-chat",
  "version": "0.2.0",
  "private": true,
  "description": "PMDA package inserts search and AI real-time streaming chat system.",
  "scripts": {
    "test:e2e": "pnpm --filter frontend test:e2e",
    "dev": "pnpm --parallel --filter frontend --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "storybook": "pnpm --filter frontend storybook",
    "build-storybook": "pnpm --filter frontend build-storybook",
    "test": "pnpm --filter backend test",
    "test:backend": "pnpm --filter backend test",
    "test:data": "pnpm --filter backend test",
    "lint": "pnpm --filter frontend lint && pnpm --filter backend lint",
    "format": "pnpm --filter frontend format && pnpm --filter backend format",
    "check": "pnpm --filter frontend check && pnpm --filter backend check",
    "typecheck": "pnpm --filter frontend typecheck && pnpm run typecheck:python",
    "typecheck:frontend": "pnpm --filter frontend typecheck",
    "typecheck:python": "pyright && pnpm --filter backend typecheck",
    "build": "pnpm --filter frontend build",
    "build:data": "pnpm --filter backend build-data",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:initialize": "pnpm --filter backend db:initialize",
    "db:rebuild": "pnpm --filter backend db:rebuild",
    "db:maintenance": "pnpm --filter backend db:maintenance",
    "db:export": "pnpm --filter backend db:export"
  },
  "devDependencies": {
    "pyright": "^1.1.414"
  }
}
