{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test:e2e:access": "playwright test --config=playwright.access.config.ts",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:e2e:mock": "playwright test",
    "test:e2e:real": "playwright test --config=playwright.import-integration.config.ts",
    "dev": "next dev",
    "dev:frontend": "next dev",
    "build": "next build",
    "lint": "biome lint .",
    "lint:stylex": "eslint --config eslint.stylex.config.mjs --no-error-on-unmatched-pattern app/**/*.ts app/**/*.tsx features/**/*.ts features/**/*.tsx shared/**/*.ts shared/**/*.tsx styles/**/*.ts",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test:ime:manual": "playwright test --config=playwright.ime-manual.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@json-render/core": "^0.21.1",
    "@json-render/react": "^0.21.1",
    "@react-spectrum/ai": "0.5.2",
    "@react-spectrum/s2": "1.8.2",
    "@stylexjs/stylex": "0.19.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/runtime": "^8.0.7",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.64.0",
    "@storybook/nextjs-vite": "^10.6.3",
    "@storybook/react": "^10.6.2",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/postcss-plugin": "0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "storybook": "^10.6.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.4"
  }
}
