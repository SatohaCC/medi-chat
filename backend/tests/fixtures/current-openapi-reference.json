            },
            "product_name": {
              "type": "string",
              "title": "Product Name"
            },
            "generic_name": {
              "type": "string",
              "title": "Generic Name"
            },
            "product_yj_codes": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "title": "Product Yj Codes"
            },
            "document_revision": {
              "additionalProperties": true,
              "type": "object",
              "title": "Document Revision"
            },
            "section": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object",
              "title": "Section"
            },
            "kind": {
              "type": "string",
              "title": "Kind"
            },
            "excerpt": {
              "type": "string",
              "title": "Excerpt"
            },
            "columns": {
              "anyOf": [
                {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Columns"
            },
            "references": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array",
              "title": "References"
            },
            "url": {
              "type": "string",
              "title": "Url"
            },
            "retrieved_by": {
              "items": {
                "$ref": "#/components/schemas/DetectionSource"
              },
              "type": "array",
              "title": "Retrieved By"
            }
          },
          "type": "object",
          "required": [
            "unit_id",
            "document_id",
            "product_name",
            "generic_name",
            "product_yj_codes",
            "document_revision",
            "section",
            "kind",
            "excerpt",
            "url"
          ],
          "title": "ChatSource",
          "description": "回答の根拠となった添付文書の文書単位（ソース）モデル"
        },
        "CleanupPendingResponse": {
          "properties": {
            "version_id": {
              "type": "string",
              "title": "Version Id"
            },
            "reason": {
              "type": "string",
              "title": "Reason"
            }
          },
          "type": "object",
          "required": [
            "version_id",
            "reason"
          ],
          "title": "CleanupPendingResponse"
        },
        "CompactMedicineResponse": {
          "properties": {
            "n": {
              "type": "string",
              "title": "N"
            },
            "k": {
              "type": "string",
              "title": "K"
            },
            "h": {
              "type": "string",
              "title": "H"
            },
            "y": {
              "type": "string",
              "title": "Y"
            },
            "g": {
              "type": "string",
              "title": "G"
            },
            "c": {
              "type": "string",
              "title": "C"
            }
          },
          "type": "object",
          "required": [
            "n",
            "k",
            "h",
            "y",
            "g",
            "c"
          ],
          "title": "CompactMedicineResponse"
        },
