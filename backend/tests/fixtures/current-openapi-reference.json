              "title": "Registration Sequence"
            },
            "active_yj_codes": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "title": "Active Yj Codes"
            },
            "replaced_yj_codes": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "title": "Replaced Yj Codes"
            },
            "deleted_version_ids": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "title": "Deleted Version Ids"
            },
            "cleanup_pending": {
              "items": {
                "$ref": "#/components/schemas/CleanupPendingResponse"
              },
              "type": "array",
              "title": "Cleanup Pending"
            },
            "artifacts_deleted": {
              "type": "boolean",
              "title": "Artifacts Deleted"
            }
          },
          "type": "object",
          "required": [
            "document_id",
            "source_sha256",
            "status",
            "reused",
            "validation_status",
            "section_count",
            "search_unit_count",
            "products",
            "revisions",
            "warnings",
            "search_index_updated",
            "generation_id",
            "registration_sequence",
            "active_yj_codes",
            "replaced_yj_codes",
            "deleted_version_ids",
            "cleanup_pending",
            "artifacts_deleted"
          ],
          "title": "AttachmentImportResponse"
        },
        "AutocompleteResponse": {
          "properties": {
            "generation_id": {
              "type": "string",
              "title": "Generation Id"
            },
            "items": {
              "items": {
                "$ref": "#/components/schemas/CompactMedicineResponse"
              },
              "type": "array",
              "title": "Items"
            }
          },
          "type": "object",
          "required": [
            "generation_id",
            "items"
          ],
          "title": "AutocompleteResponse"
        },
        "ChatRequest": {
          "properties": {
            "message": {
              "type": "string",
              "maxLength": 2000,
              "minLength": 1,
              "title": "Message"
            },
            "product_yj_codes": {
              "items": {
                "type": "string",
                "pattern": "^[0-9A-Z]{12}$"
              },
              "type": "array",
              "maxItems": 50,
              "minItems": 1,
              "title": "Product Yj Codes"
            },
            "provider": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Provider"
            },
            "model": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Model"
            }
          },
          "type": "object",
          "required": [
            "message",
            "product_yj_codes"
          ],
          "title": "ChatRequest",
          "description": "REST API 経由で受信するチャット同期リクエストモデル"
        },
        "ChatResponse": {
          "properties": {
            "answer": {
              "type": "string",
