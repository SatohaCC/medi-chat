{
  "schema": {
    "openapi": "3.1.0",
    "info": {
      "title": "medi-chat API",
      "description": "Search PMDA package inserts and real-time streaming AI chat.",
      "version": "0.2.0"
    },
    "paths": {
      "/health": {
        "get": {
          "tags": [
            "system"
          ],
          "summary": "Health",
          "description": "読み込まれた医薬品コーパスの稼働状態および統計情報を確認する",
          "operationId": "health_health_get",
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HealthResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/api/": {
        "get": {
          "tags": [
            "system"
          ],
          "summary": "Api Health",
          "description": "軽量なヘルスチェックプローブ用エンドポイント",
          "operationId": "api_health_api__get",
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object",
                    "title": "Response Api Health Api  Get"
                  }
                }
              }
            }
          }
        }
      },
      "/api": {
        "get": {
          "tags": [
            "system"
          ],
          "summary": "Api Health",
          "description": "軽量なヘルスチェックプローブ用エンドポイント",
          "operationId": "api_health_api_get",
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object",
                    "title": "Response Api Health Api Get"
                  }
                }
              }
            }
          }
        }
      },
      "/api/medicines": {
        "get": {
          "tags": [
            "catalog"
          ],
          "summary": "Medicines",
          "description": "全医薬品カタログを返却する",
          "operationId": "medicines_api_medicines_get",
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/MedicineListResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/api/medicines/autocomplete": {
        "get": {
          "tags": [
            "catalog"
          ],
          "summary": "Autocomplete",
          "operationId": "autocomplete_api_medicines_autocomplete_get",
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/AutocompleteResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/api/search": {
        "get": {
          "tags": [
            "search"
          ],
          "summary": "Keyword Search",
          "description": "添付文書からキーワードに合致する根拠単位を検索する",
          "operationId": "keyword_search_api_search_get",
          "parameters": [
            {
              "name": "q",
              "in": "query",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "検索キーワード（スペース区切りで複数指定可）",
                "title": "Q"
              },
              "description": "検索キーワード（スペース区切りで複数指定可）"
            },
            {
              "name": "yj_codes",
              "in": "query",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "絞り込み対象の医薬品YJコード（未指定時は全医薬品を検索）",
                "title": "Yj Codes"
              },
              "description": "絞り込み対象の医薬品YJコード（未指定時は全医薬品を検索）"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/KeywordSearchResponse"
                  }
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/chat": {
        "post": {
          "tags": [
            "chat"
          ],
          "summary": "Chat",
          "description": "添付文書の根拠引用および任意のLLM文章生成を伴う質問回答を行う",
          "operationId": "chat_api_chat_post",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ChatResponse"
                  }
                }
              }
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/attachment-imports": {
        "post": {
          "tags": [
            "attachment-imports"
          ],
          "summary": "Import Attachment",
          "operationId": "import_attachment_api_attachment_imports_post",
          "requestBody": {
            "content": {
              "multipart/form-data": {
                "schema": {
                  "properties": {
                    "file": {
                      "type": "string",
                      "format": "binary"
                    }
                  },
                  "type": "object",
                  "required": [
                    "file"
                  ]
                }
              }
            },
            "required": true
          },
          "responses": {
            "201": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/AttachmentImportResponse"
                  }
                }
              }
            },
            "200": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/AttachmentImportResponse"
                  }
                }
              }
            },
            "409": {
              "description": "Conflict",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ImportConflictResponse"
                  }
                }
              }
            },
            "400": {
              "description": "Bad Request",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ImportErrorResponse"
                  }
                }
              }
            },
            "413": {
              "description": "Content Too Large",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ImportErrorResponse"
                  }
                }
              }
            },
            "415": {
              "description": "Unsupported Media Type",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ImportErrorResponse"
                  }
                }
              }
            },
            "422": {
              "description": "Unprocessable Content",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ImportErrorResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ImportErrorResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/api/attachment-imports/{document_id}/{source_sha256}": {
        "get": {
          "tags": [
            "attachment-imports"
          ],
          "summary": "Read Attachment",
          "operationId": "read_attachment_api_attachment_imports__document_id___source_sha256__get",
          "parameters": [
            {
              "name": "document_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "title": "Document Id"
              }
            },
            {
              "name": "source_sha256",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "title": "Source Sha256"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Response",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/AttachmentImportResponse"
                  }
                }
              }
            },
            "404": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ImportErrorResponse"
                  }
                }
              },
              "description": "Not Found"
            },
            "409": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ImportErrorResponse"
                  }
                }
              },
              "description": "Conflict"
            },
            "410": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ImportErrorResponse"
                  }
                }
              },
              "description": "Gone"
            },
            "500": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ImportErrorResponse"
                  }
                }
              },
              "description": "Internal Server Error"
            },
            "422": {
              "description": "Validation Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "AttachmentImportResponse": {
          "properties": {
            "document_id": {
              "type": "string",
              "title": "Document Id"
            },
            "source_sha256": {
              "type": "string",
              "title": "Source Sha256"
            },
            "status": {
              "type": "string",
              "title": "Status"
            },
            "reused": {
              "type": "boolean",
              "title": "Reused"
            },
            "validation_status": {
              "type": "string",
              "title": "Validation Status"
            },
            "section_count": {
              "type": "integer",
              "title": "Section Count"
            },
            "search_unit_count": {
              "type": "integer",
              "title": "Search Unit Count"
            },
            "products": {
              "items": {
                "$ref": "#/components/schemas/ImportedProductResponse"
              },
              "type": "array",
              "title": "Products"
            },
            "revisions": {
              "items": {
                "$ref": "#/components/schemas/ImportedRevisionResponse"
              },
              "type": "array",
              "title": "Revisions"
            },
            "warnings": {
