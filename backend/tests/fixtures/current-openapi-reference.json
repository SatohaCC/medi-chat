            },
            "intent": {
              "type": "string",
              "title": "Intent"
            },
            "retrieval_strategy": {
              "type": "string",
              "title": "Retrieval Strategy"
            },
            "resolved_medicines": {
              "items": {
                "$ref": "#/components/schemas/MedicineMatch"
              },
              "type": "array",
              "title": "Resolved Medicines"
            },
            "sources": {
              "items": {
                "$ref": "#/components/schemas/ChatSource"
              },
              "type": "array",
              "title": "Sources"
            },
            "needs_clarification": {
              "type": "boolean",
              "title": "Needs Clarification",
              "default": false
            },
            "notices": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "title": "Notices"
            },
            "jev_response": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Jev Response"
            }
          },
          "type": "object",
          "required": [
            "answer",
            "intent",
            "retrieval_strategy"
